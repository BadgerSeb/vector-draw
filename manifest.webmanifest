{
  "name": "Vector Draw — Badger Metal & Machine Fabrication",
  "short_name": "Vector Draw",
  "description": "Draw and edit vector artwork, cut files and drawings to scale. Open and save SVG, DXF, PDF and PNG. Everything stays on your computer.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1b1d20",
  "theme_color": "#1b1d20",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-vector-draw": [".vdraw"],
        "image/svg+xml": [".svg"],
        "application/dxf": [".dxf"]
      },
      "launch_type": "single-client"
    }
  ]
}
